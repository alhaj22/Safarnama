# ========================================
# Safarnama - Backend Environment Variables
# ========================================
# Copy this file to .env and fill in real values
# NEVER commit the actual .env file to Git!

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Secret - use a long random string in production
JWT_SECRET=your_very_long_and_secure_jwt_secret_here

# Server port (Vercel ignores this; for local dev only)
PORT=5001

# Frontend URL (for CORS whitelist) - set in Vercel dashboard
# e.g. https://safarnama-frontend.vercel.app
FRONTEND_URL=http://localhost:3000
