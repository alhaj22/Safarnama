# ==========================================
# Safarnama - Frontend Environment Variables
# ==========================================
# Copy this file to .env and fill in real values.
# In Create React App, all env variables MUST start with REACT_APP_
# NEVER commit the actual .env file to Git!

# Your backend Vercel API URL (no trailing slash)
# e.g. https://safarnama-backend.vercel.app
REACT_APP_API_URL=http://localhost:5001
